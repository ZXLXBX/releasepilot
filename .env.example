# ReleasePilot provider selection — copy to .env or export in your shell.
# No value in this file is a real secret; real keys live only in your env.

# Force a provider: ollama | cortensor-portal | echo
# Leave unset for auto: cortensor-portal if CORTENSOR_API_KEY set,
# else local ollama if running, else the offline echo demo provider.
RELEASEPILOT_PROVIDER=
RELEASEPILOT_MODEL=

# Only needed for the Cortensor Portal route (hosted Cortensor inference).
# Portal/Gemma4 access is coordinated by the hackathon team; see README.
CORTENSOR_API_KEY=

# Optional: point the agent at a different repo-shaped folder of issues.
RELEASEPILOT_REPO=
